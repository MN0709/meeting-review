# 必填；本地开发也必须设置。格式：团队名:口令,团队名:口令。
# 口令强度要求（启动时校验，不合规直接拒绝启动）：
#   · 长度 ≥ 16 位
#   · 不能是纯数字；不能是纯英文（含中文的长口令可用）
# 生成示例：python3 -c "import secrets;print('mr-'+secrets.token_urlsafe(16))"
TEAM_TOKENS=替换成你的团队名:替换成16位以上含数字与符号的随机口令

# OpenAI 或兼容 OpenAI Chat Completions 协议的服务
OPENAI_API_KEY=your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# faster-whisper；CPU 默认用 int8，CUDA 可根据显卡改为 float16
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# 本地说话人分离与声纹匹配；首次使用会下载 WeSpeaker 中文模型
SPEAKER_RECOGNITION_ENABLED=true
SPEAKER_MODEL=chinese
# 高于阈值且与第二候选的差值达标才自动识别，否则回退“待确认”
SPEAKER_MATCH_THRESHOLD=0.72
SPEAKER_MATCH_MARGIN=0.05
# 同一场会议中被过度切分的声音高于此阈值时合并；且两簇各自命中不同成员时一律不合并。
# 2026-09-21 用真实录音校准：不同人的簇相似度实测可达 0.789，故由 0.78 上调到 0.85。
SPEAKER_INTRA_MERGE_THRESHOLD=0.85

# 其他可调参数
APP_HOST=127.0.0.1
APP_PORT=8000
# 只信任这些直接反向代理的转发头；多个地址用逗号分隔
FORWARDED_ALLOW_IPS=127.0.0.1
MAX_UPLOAD_MB=300
# POC 支持最长 4 小时；长会议建议使用 M4A/MP3 压缩音频
MAX_AUDIO_MINUTES=240
# 4 小时会议在 CPU 上可能处理数小时，允许后台继续运行
PROCESSING_TIMEOUT_SECONDS=21600
TASK_RETENTION_MINUTES=30
RATE_LIMIT_PER_HOUR=10
DAILY_TASK_LIMIT=30
QUEUE_MAX=5
DATABASE_PATH=data/meeting-review.db
LLM_MAX_RETRIES=2
# 分块分析的并发上限（R-P1-7）；避免 4 小时会议无条件并发数十次调用
LLM_MAX_CONCURRENCY=4
TRANSCRIPT_CHUNK_CHARS=6000

# LLM 成本换算单价（每 1000 token）；留空则只记录 token，接口返回的 cost 为 null。
# 不要在这里写死价格，按厂商实际报价填写，随时可改，无需改代码。
LLM_PRICE_PROMPT_PER_1K=
LLM_PRICE_COMPLETION_PER_1K=

# Agent 层开关（PRD v1.1 §13.1）。全部有安全默认值，不填即保持 pipeline 旧行为。
# AGENT_MODE: pipeline（默认，零行为变化）/ shadow（并行对拍不落库）/ agent（模型自主编排）
AGENT_MODE=pipeline
# 单会话最大步数，超限安全终止；终止条件是“模型不再产生 tool_use”，不是固定轮次
AGENT_MAX_STEPS=20
# 上下文预算（token），超预算触发压缩；默认 60000
AGENT_CONTEXT_BUDGET_TOKENS=60000
# 允许模型调用的工具级别：readonly（默认）或逗号分隔的工具名
AGENT_TOOLS_ENABLED=readonly
# 写工具总开关；P1 阶段固定 false，任何写工具都不上线
AGENT_WRITE_TOOLS_ENABLED=false
# 是否写入 agent_audit 审计表
AGENT_AUDIT_ENABLED=true
# 单步超时（一次模型调用或一次工具执行），超时安全终止
AGENT_STEP_TIMEOUT_SECONDS=120
# 单会话总超时，超时安全终止
AGENT_SESSION_TIMEOUT_SECONDS=1800
# 完成判定评估器：rule（默认，零成本可复现）/ model（按 stage=goal_judge 单独计费）
AGENT_GOAL_JUDGE=rule
